# Ditto release build. Every arg here was checked against Chromium's
# 156.0.8078.80 .gni files; scripts/build.sh fails if one stops existing.

# Speed: official optimized build with ThinLTO and the PGO profiles that
# scripts/fetch.sh downloads (checkout_pgo_profiles).
is_official_build = true
is_debug = false
is_component_build = false
dcheck_always_on = false

# Size: no debug symbols in the shipped app.
symbol_level = 0

# Not a Google Chrome build: no Google API keys are baked in, so Chrome
# Sync and Google's browser sign-in stay off (see docs/GOOGLE_ACCOUNT.md).
# Signing in to Google *websites* works as in any browser.
is_chrome_branded = false
use_official_google_api_keys = false

# Media: H.264/AAC so ordinary video sites work.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Widevine needs a VMP-signed build from Google; off until that exists.
enable_widevine = false

# Trimmed features: Ditto is a browser, Google sign-in, bookmarks and the
# local agent. scripts/probe-args.sh drops any a Chromium version asserts on.
enable_remoting = false                     # Chrome Remote Desktop host
enable_hangout_services_extension = false   # Google Meet helper extension
enable_mdns = false                         # LAN discovery (Cast)
enable_service_discovery = false            # local printers and Cast devices
enable_reporting = false                    # Reporting API / NEL uploads
enable_pdf_save_to_drive = false            # PDF viewer's Save to Google Drive
enable_media_remoting = false               # Cast media remoting
enable_vr = false                           # WebXR devices
enable_openxr = false                       # OpenXR runtime
enable_platform_experience = false          # Google's OS-level promos
enable_update_notifications = false         # Chrome's updater UI

treat_warnings_as_errors = false
