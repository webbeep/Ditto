import("//ui/webui/resources/tools/build_webui.gni")

# agent_files.gni is written by scripts/sync-overlay.sh from //agent/src (the
# agent runtime is developed and tested there, outside the Chromium tree).
import("agent/agent_files.gni")

build_webui("build") {
  grd_prefix = "ditto_agent"

  static_files = [
    "ditto_agent.css",
    "ditto_agent.html",
    "home.html",
  ]

  non_web_component_files = [
    "app.ts",
    "chat_storage.ts",
    "home.ts",
    "icons.ts",
    "mojo_transports.ts",
    "ui.ts",
  ] + ditto_agent_ts_files

  mojo_files_deps = [ "//ditto/browser:mojo_bindings_ts__generator" ]
  mojo_files = [ "$root_gen_dir/ditto/browser/ui/webui/ditto_agent.mojom-webui.ts" ]

  ts_deps = [
    "//ui/webui/resources/js:build_ts",
    "//ui/webui/resources/mojo:build_ts",
  ]
  webui_context_type = "trusted"
}
