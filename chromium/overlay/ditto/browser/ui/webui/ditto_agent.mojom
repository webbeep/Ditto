module ditto.mojom;

// Where an HTTP request goes. The page never learns the runtime's port or
// API key: the browser process adds them.
enum Target {
  kRuntime,
  kStrandsSidecar,
};

struct HttpResponse {
  // 0 when the request could not be made at all.
  int32 status;
  string body;
};

struct TabTarget {
  bool ok;
  string url;
  string title;
};

// Used by chrome://ditto-agent to create its page handler.
// One of the user's own pages: a bookmark or a history entry.
struct SavedPage {
  string url;
  string title;
  // When it was bookmarked or last visited (ms since the Unix epoch).
  double time_ms;
  bool bookmark;
};

interface PageHandlerFactory {
  CreatePageHandler(pending_remote<Page> page,
                    pending_receiver<PageHandler> handler);
};

// Browser-side services for the agent UI.
interface PageHandler {
  // Starts the bundled llama-server router if it is not running.
  // `preset_ini` comes from the agent's model catalog.
  StartRuntime(string preset_ini, uint32 memory_margin_mb) => (bool ok);
  // Stops the runtime and frees all model memory (e.g. "disable all models").
  StopRuntime();
  SetStrandsEndpoint(string url);
  GetSystemMemory() => (uint64 total_mb, uint64 available_mb);
  // The user's default search engine as a URL with `%s` for the query;
  // empty if there is none.
  GetSearchUrl() => (string url_template);
  // Chat history, stored by the browser in the profile so the agent panel
  // and the home page (different chrome:// origins) share it.
  LoadChats() => (string json);
  SaveChats(string json);

  // The agent's notes about the user (JSON), kept in the profile next to
  // the chats. Written only by the agent pages; never sent anywhere.
  LoadMemory() => (string json);
  SaveMemory(string json);
  // The user's bookmarks and history (last 90 days) matching `query`,
  // bookmarks first; http(s) pages only.
  SearchUserPages(string query, int32 max_results) => (array<SavedPage> pages);

  // Moving from Chrome: copies the bookmarks of the user's Google Chrome
  // profile into this one. `found` is false when there is no Chrome profile
  // to read; `email` is the Google account signed in there, if any.
  ImportFromChrome() => (bool found, int32 bookmarks, string email);

  // From the home page: opens the agent panel in this window and hands it a
  // question to ask, or a chat to open (either may be empty).
  ShowAgentPanel(string query, string chat_id);
  // For the panel: the hand-off waiting for this window, if any (once).
  TakeHandOff() => (string query, string chat_id);

  Fetch(Target target, string method, string path, string body)
      => (HttpResponse response);
  // Chunks of a server-sent-events reply arrive as Page.OnStreamChunk with
  // the same `stream_id`; the reply comes when the stream ends.
  FetchStream(Target target, string path, string body, int32 stream_id)
      => (HttpResponse response);

  // Attaches to the active tab of this window. When the agent UI itself is
  // the active tab, a new tab is opened next to it for the agent to drive.
  AttachToActiveTab() => (TabTarget target);
  DetachFromTab();
  // Chrome DevTools Protocol command on the attached tab.
  SendCdp(string method, string params_json) => (bool ok, string result_json);
};

interface Page {
  OnStreamChunk(int32 stream_id, string chunk);
  // The browser is low on memory: unload models (responder first).
  OnMemoryPressure(bool critical);
  // The attached tab closed or navigated somewhere the agent may not go.
  OnTabDetached();
  // A hand-off is waiting (call TakeHandOff).
  OnHandOff();
};
