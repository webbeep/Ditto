# Compiled into //chrome/browser/ui:ui (see patch 0005) so the agent WebUI can
# use browser/ui headers like the other chrome:// pages do.

ditto_browser_ui_sources = []
ditto_browser_ui_deps = []

if (is_mac || is_linux) {
  ditto_browser_ui_sources += [
    "//ditto/browser/agent/cdp_relay.cc",
    "//ditto/browser/agent/cdp_relay.h",
    "//ditto/browser/inference/inference_supervisor.cc",
    "//ditto/browser/inference/inference_supervisor.h",
    "//ditto/browser/ui/webui/ditto_agent_page_handler.cc",
    "//ditto/browser/ui/webui/ditto_agent_page_handler.h",
    "//ditto/browser/ui/views/side_panel/ditto_agent_side_panel.cc",
    "//ditto/browser/ui/views/side_panel/ditto_agent_side_panel.h",
    "//ditto/browser/ui/webui/ditto_agent_ui.cc",
    "//ditto/browser/ui/webui/ditto_agent_ui.h",
  ]
  ditto_browser_ui_deps += [
    "//ditto/browser:mojo_bindings",
    "//ditto/browser/resources",
  ]
}
