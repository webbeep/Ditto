{
  "manifest_version": 3,
  "name": "Ditto Agent",
  "version": "0.1.0",
  "description": "Ditto's local browsing agent: small open-weight models that read, navigate and answer, on your Mac.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ditto_agent.html"
  },
  "action": {
    "default_title": "Ditto Agent"
  },
  "permissions": [
    "sidePanel",
    "debugger",
    "nativeMessaging",
    "search",
    "system.memory",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
