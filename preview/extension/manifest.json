{
  "manifest_version": 3,
  "name": "Ditto Agent",
  "version": "0.2.0",
  "description": "Ditto's local browsing agent and home page.",
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "ditto_agent.html"
  },
  "action": {
    "default_title": "Ditto",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "sidePanel",
    "debugger",
    "nativeMessaging",
    "search",
    "system.memory",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "chrome_url_overrides": {
    "newtab": "home.html"
  }
}
