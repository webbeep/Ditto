{
  "name": "@ditto/agent",
  "version": "0.1.0",
  "private": true,
  "description": "Ditto's local browser agent: LLM responder + decision-model navigator over llama.cpp.",
  "type": "module",
  "license": "BSD-3-Clause",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node --test \"dist/test/**/*.test.js\"",
    "demo": "tsc -p . && node dist/dev/cli.js",
    "eval": "tsc -p . && node dist/eval/run.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^6.0.2"
  }
}
